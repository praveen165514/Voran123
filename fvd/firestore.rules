rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
    
    match /quizSessions/{sessionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true; // allow host to update and students might read
    }
    
    match /participants/{participantId} {
      allow read: if true;
      allow create: if true;
      allow update: if true; // students updating their score
    }
    
    match /responses/{responseId} {
      allow read: if true;
      allow create: if true;
    }
  }
}
